@startuml
title Log out (GET /api/v1/auth/logout)
skinparam sequence {
  ParticipantBackgroundColor #A9C4C9
  ParticipantBorderColor #7A9EA4
  LifeLineBorderColor #444444
}
skinparam database {
  BackgroundColor #A9C4C9
  BorderColor #7A9EA4
}
skinparam backgroundColor #DCE6F7
skinparam defaultFontSize 13
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as router
participant "<<controllers>>\n:auth" as ctrl

[-> server ++ : req.get('/auth/logout')
server -> router ++ : app.use('/api/v1/auth', auth)
router -> ctrl ++ : logout
ctrl -> ctrl : res.cookie('token', 'none',\n{expires: now + 10s})
ctrl -->[ : 200 {success: true, data: {}}
deactivate ctrl
deactivate router
deactivate server
@enduml
