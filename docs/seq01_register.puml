@startuml
title Register (POST /api/v1/auth/register)
skinparam sequence {
  ParticipantBackgroundColor #A9C4C9
  ParticipantBorderColor #7A9EA4
  LifeLineBorderColor #444444
}
skinparam database {
  BackgroundColor #A9C4C9
  BorderColor #7A9EA4
}
skinparam backgroundColor #DCE6F7
skinparam defaultFontSize 13
participant "<<javaScript>>\n:server" as server
participant "<<router>>\n:auth" as router
participant "<<controllers>>\n:auth" as ctrl
participant "<<model>>\n:User" as model
database "<<MongoDB>>\n:users" as db

[-> server ++ : req.post('/auth/register')\n{name, tel, email, password}
server -> router ++ : app.use('/api/v1/auth', auth)
router -> ctrl ++ : register
ctrl -> model ++ : create({name, tel, email, password})
note right of ctrl: role is not read from the body:\nself-registered users are always 'user'
model -> model : validate (tel required, email format)\npre('save'): bcrypt hash password
model -> db ++ : UserSchema
db --> model -- : user
model --> ctrl -- : user
alt validation passed
  ctrl -> model : getSignedJwtToken()
  ctrl -->[ : 201 {success: true, token}\n+ cookie 'token'
else invalid data / missing tel / duplicate email
  ctrl -->[ : 400 {success: false}
end
deactivate ctrl
deactivate router
deactivate server
@enduml
