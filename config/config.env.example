PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/CoworkingSpace?appName=<app>
JWT_SECRET=<long random string>
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Password reset email. Leave SMTP_HOST empty in development to print the email in the server console instead.
# Base URL the reset link points to (e.g. your frontend page); the token is appended as /resetpassword/<token>
CLIENT_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
